# Basic security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ------------------------------------------------------------
# Clean URLs
#
# Information pages (/about/ and so on), sitemap.xml and robots.txt
# are mapped first. All other public paths start with a two-letter
# country prefix:
#   /uk/                                    index.php        (country home)
#   /uk/mortgages/                          category.php
#   /uk/mortgages/fixed-rate/               subcategory.php
#   /uk/mortgages/fixed-rate/2-year-fixed/  fact.php
#
# These rules only map a path to the right script. Each page then
# checks it was reached at its canonical address and 301-redirects if
# not (no trailing slash, an old URL, or a subject that has moved
# subcategory). That logic lives in PHP, in redirectToCanonical(), so
# there's only one place where URLs are decided.
# ------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # --- One address for the whole site ---
    # Permanently redirect www.financefactlibrary.com to financefactlibrary.com,
    # keeping the rest of the address (path and any query string), so
    # links and rankings are never split between two versions of the site.
    # Comes before everything else so it applies to real files too.
    # Local development hosts (e.g. financefactlibrary:8888) don't start with
    # www, so they're unaffected. HTTPS itself is enforced by Hostinger's
    # "Force HTTPS" setting rather than here, because Hostinger's CDN
    # handles the secure connection before requests reach this file.
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

    # Real files and folders (assets/, admin/, and direct hits on the
    # .php pages) are served as they are, never rewritten.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # --- Site files and information pages ---
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
    RewriteRule ^robots\.txt$ robots.php [L]
    RewriteRule ^about/?$ about.php [L,QSA]
    RewriteRule ^how-we-check-our-figures/?$ how-we-check.php [L,QSA]
    RewriteRule ^disclaimer/?$ disclaimer.php [L,QSA]
    RewriteRule ^privacy/?$ privacy.php [L,QSA]

    # --- Country URLs ---
    RewriteRule ^([a-z]{2})/?$ index.php?country=$1 [L,QSA]
    RewriteRule ^([a-z]{2})/([^/]+)/?$ category.php?country=$1&slug=$2 [L,QSA]
    RewriteRule ^([a-z]{2})/([^/]+)/([^/]+)/?$ subcategory.php?country=$1&category=$2&slug=$3 [L,QSA]
    RewriteRule ^([a-z]{2})/([^/]+)/([^/]+)/([^/]+)/?$ fact.php?country=$1&category=$2&subcategory=$3&slug=$4 [L,QSA]

    # --- Articles (dormant, not tied to a country yet) ---
    RewriteRule ^article/([^/]+)/?$ article.php?slug=$1 [L,QSA]

    # --- Old pre-country URLs ---
    # Mapped to the same scripts without a country. The page falls back
    # to the default country and 301-redirects to the new address.
    RewriteRule ^category/([^/]+)/([^/]+)/?$ subcategory.php?category=$1&slug=$2 [L,QSA]
    RewriteRule ^category/([^/]+)/?$ category.php?slug=$1 [L,QSA]
    RewriteRule ^fact/([^/]+)/?$ fact.php?slug=$1 [L,QSA]
</IfModule>
